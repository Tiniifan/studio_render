*.pyc
.venv/
screenshots/

# Preferences of the user, written by the application
studio_render.ini
studio_render.log

# Official template projects and what builds them (the tool and the specs, with their source paths): kept local
official_projects/
tools/build_template.py
tools/templates/

# Builds of build_exe.bat: out/<version>/studio_render/ and studio_render.zip
out/

# Local documents
docs/
/build_venv
