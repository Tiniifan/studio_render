# Local script that refreshes studio_eleven/ from the Blender addon, never committed
sync_studio_eleven.bat

# Game data unpacked at run time from studio_eleven/rendering/games/*.zip; studio_render does not use the default
# games of studio_eleven (default_v1, default_v2), they are not versioned either
studio_eleven/rendering/games/*/
studio_eleven/rendering/games/installed.json

